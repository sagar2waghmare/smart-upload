{
  "name": "smart-upload",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "media:prepare": "node scripts/prepare-media.mjs",
    "dev:vinext": "vinext dev --port 3001",
