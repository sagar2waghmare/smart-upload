    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10",
    "hls.js": "^1.7.3",
    "@vidstack/react": "1.12.13",
    "vidstack": "1.12.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.4",
