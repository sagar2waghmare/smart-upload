# Smart Upload — environment variables
# Copy this file to .env.local and fill in your values.
# Secrets here are NEVER sent to the browser.

# -----------------------------------------------------------
# Application mode
# demo  = local mock library + sample playback + upload "not-configured" states
# real  = live AWS + CloudShell + TMDB integration
# -----------------------------------------------------------
NEXT_PUBLIC_APP_MODE=demo

# Human-readable app name shown in header/footer
NEXT_PUBLIC_APP_NAME=Smart Upload

# Public version string
NEXT_PUBLIC_APP_VERSION=0.1.0

# Public video used when no real playback URL is available.
# This is intentionally a public Google sample video.
NEXT_PUBLIC_DEMO_VIDEO_URL=https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4

# -----------------------------------------------------------
# AWS Library API (server-side only)
# The app proxies this from the browser through its own routes.
# The browser never receives this URL or key directly.
# -----------------------------------------------------------
AWS_LIBRARY_API_URL=
AWS_LIBRARY_API_KEY=
AWS_LIBRARY_API_KEY_HEADER=x-api-key

# -----------------------------------------------------------
# CloudShell Upload API (server-side only)
# The frontend posts a media URL to /api/upload-url,
# which forwards the request here.
# Expected response: { status, message, filename }
# -----------------------------------------------------------
CLOUDSHELL_UPLOAD_URL=
CLOUDSHELL_API_KEY=
CLOUDSHELL_API_KEY_HEADER=x-api-key

# When true AND CloudShell is not configured, the upload endpoint
# returns a clearly-marked "queued" demo response instead of
# "not-configured". Keep false in production to avoid confusion.
ALLOW_DEMO_UPLOAD=false

# -----------------------------------------------------------
# TMDB Metadata Service (server-side only)
# Required for accurate title → metadata resolution.
# Appears in /api/identify and /api/metadata.
# -----------------------------------------------------------
TMDB_API_KEY=

# -----------------------------------------------------------
# Firebase Authentication (client config — public by design)
# Google sign-in via Firebase Auth. Session cookies are issued
# server-side and verified on every protected /api/* route.
# -----------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# -----------------------------------------------------------
# Firebase Admin (SERVER-SIDE ONLY — never exposed to browser)
# Paste the full contents of the service account JSON into
# FIREBASE_SERVICE_ACCOUNT_JSON (as one line), OR set the three
# fields below individually.
# -----------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON=

# Allowed emails for Google sign-in (comma-separated, lowercase).
# If blank, sign-in is denied for everyone — a private library
# must explicitly allowlist its users. e.g. you@gmail.com,dad@gmail.com
ALLOWED_EMAILS=

# -----------------------------------------------------------
# Image domains (for Next.js image optimization)
# Remote hosts are already configured in next.config.ts:
#   - image.tmdb.org
#   - *.googleapis.com
#   - *.amazonaws.com
# -----------------------------------------------------------